# ── AgentForge 生产环境变量 ──
# 复制为 .env.production 并填入实际值：
#   cp infra/docker/.env.production.example infra/docker/.env.production
#
# 启动：docker compose -f infra/docker/docker-compose.prod.yml --env-file infra/docker/.env.production up -d

# ════════════════════════════════════════════════════════════════
# 数据库密钥
# ════════════════════════════════════════════════════════════════
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=change-me-use-strong-random-password
POSTGRES_DB=agentforge

# ════════════════════════════════════════════════════════════════
# Redis 密钥
# ════════════════════════════════════════════════════════════════
REDIS_PASSWORD=change-me-use-strong-random-password

# ════════════════════════════════════════════════════════════════
# MinIO 密钥（Milvus 向量存储后端）
# ════════════════════════════════════════════════════════════════
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-use-strong-random-password

# ════════════════════════════════════════════════════════════════
# LLM API 密钥（必需）
# ════════════════════════════════════════════════════════════════
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek（可选，性价比更高的备选 LLM）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 默认模型
DEFAULT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-v3

# ════════════════════════════════════════════════════════════════
# 前端地址（CORS 白名单，逗号分隔）
# ════════════════════════════════════════════════════════════════
CORS_ORIGINS=https://cs.yourdomain.com,https://admin.yourdomain.com

# ════════════════════════════════════════════════════════════════
# Langfuse 密钥（LLM 可观测性）
# ════════════════════════════════════════════════════════════════
LANGFUSE_ENABLED=true
LANGFUSE_NEXTAUTH_URL=https://langfuse.yourdomain.com
LANGFUSE_NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
LANGFUSE_SALT=change-me-generate-with-openssl-rand-hex-32
LANGFUSE_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key

# ════════════════════════════════════════════════════════════════
# OpenTelemetry（可选，默认关闭）
# ════════════════════════════════════════════════════════════════
OTEL_ENABLED=false

# ════════════════════════════════════════════════════════════════
# 功能开关
# ════════════════════════════════════════════════════════════════
VOICE_ENABLED=true
VIDEO_ENABLED=true
VIDEO_MODEL=gpt-4o

# ════════════════════════════════════════════════════════════════
# 服务端口
# ════════════════════════════════════════════════════════════════
WEB_PORT=80

{
  "name": "agentforge",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev --filter=@agentforge/server --filter=@agentforge/web",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:restart": "docker compose -f infra/docker/docker-compose.yml down && docker compose -f infra/docker/docker-compose.yml up -d",
    "server:dev": "pnpm --filter @agentforge/server dev",
    "web:dev": "pnpm --filter @agentforge/web dev",
    "db:migrate": "pnpm --filter @agentforge/database db:migrate",
    "db:seed": "pnpm --filter @agentforge/database db:seed",
    "db:studio": "pnpm --filter @agentforge/database db:studio",
    "db:generate": "pnpm --filter @agentforge/database db:generate",
    "start": "powershell -ExecutionPolicy Bypass -File start.ps1"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.0"
  }
}
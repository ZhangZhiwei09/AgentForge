FROM ghcr.io/astral-sh/uv:0.11.19 AS uv
FROM python:3.12-slim

COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1 PYTHONUTF8=1
COPY apps/server-py/pyproject.toml apps/server-py/uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY apps/server-py/src ./src
COPY apps/server-py/scripts ./scripts
COPY apps/server-py/alembic ./alembic
COPY apps/server-py/alembic.ini ./
RUN groupadd --gid 10001 agentforge && useradd --uid 10001 --gid agentforge agentforge \
    && mkdir -p /app/data/knowledge-files && chown -R agentforge:agentforge /app/data
ENV PATH="/app/.venv/bin:$PATH" KNOWLEDGE_STORAGE_ROOT=/app/data/knowledge-files
USER agentforge
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4)"
CMD ["python", "-m", "src.dev", "--no-reload"]

{
  "name": "agentforge",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev --filter=@agentforge/customer-service --filter=@agentforge/data-admin --filter=@agentforge/server-py",
    "dev:agent-flows": "node scripts/dev-agent-flows.mjs",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:restart": "docker compose -f infra/docker/docker-compose.yml down && docker compose -f infra/docker/docker-compose.yml up -d",
    "server:dev": "pnpm --filter @agentforge/server-py dev",
    "server:worker": "pnpm --filter @agentforge/server-py worker",
    "cs:dev": "pnpm --filter @agentforge/customer-service dev",
    "py:dev": "pnpm --filter @agentforge/server-py dev",
    "py:api": "pnpm --filter @agentforge/server-py dev:public",
    "py:test": "pnpm --filter @agentforge/server-py test",
    "admin:dev": "pnpm --filter @agentforge/data-admin dev",
    "db:migrate": "pnpm --filter @agentforge/server-py db:migrate",
    "db:check": "pnpm --filter @agentforge/server-py db:check",
    "db:admin": "pnpm --filter @agentforge/server-py db:admin",
    "db:seed": "pnpm --filter @agentforge/server-py db:seed",
    "db:seed:intents": "pnpm --filter @agentforge/server-py db:seed:intents"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  }
}

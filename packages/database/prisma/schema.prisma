generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @db.VarChar(36)
  email         String         @unique(map: "ix_users_email") @db.VarChar(255)
  passwordHash  String?        @map("password_hash") @db.VarChar(255)
  avatarUrl     String?        @map("avatar_url") @db.VarChar(500)
  role          String         @default("user") @db.VarChar(20)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  conversations Conversation[]
  memories      Memory[]
  refreshTokens RefreshToken[]
  apiKeys       ApiKey[]
  workflows     Workflow[]
  workflowRuns  WorkflowRun[]
  agentTeams    AgentTeam[]
  agentTeamRuns AgentTeamRun[]
  appProjects   AppProject[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ix_refresh_tokens_user_id")
  @@index([tokenHash], map: "ix_refresh_tokens_token_hash")
  @@map("refresh_tokens")
}

model ApiKey {
  id        String    @id @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  name      String    @db.VarChar(100)
  keyHash   String    @map("key_hash") @db.VarChar(255)
  lastUsed  DateTime? @map("last_used") @db.Timestamptz(6)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ix_api_keys_user_id")
  @@index([keyHash], map: "ix_api_keys_key_hash")
  @@map("api_keys")
}

model Conversation {
  id        String    @id @db.VarChar(36)
  title     String    @db.VarChar(255)
  userId    String    @map("user_id") @db.VarChar(36)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  type           String         @default("chat") @db.VarChar(32)
  sessionId      String?        @map("session_id") @db.VarChar(64)
  intent         String?        @db.VarChar(100)
  rating         String?        @db.VarChar(20)
  status         String?        @default("active") @db.VarChar(20)
  customerMeta   Json?          @map("customer_meta")
  user           User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  memories       Memory[]
  messages       Message[]
  agentSessions  AgentSession[]
  ratings        SatisfactionRating[]
  approvals      AgentApproval[]
  voiceSessions  VoiceSession[]
  videoSessions  VideoSession[]

  @@index([sessionId], map: "ix_conversations_session_id")
  @@index([userId], map: "ix_conversations_user_id")
  @@index([userId, updatedAt], map: "ix_conversations_user_updated")
  @@index([type, createdAt], map: "ix_conversations_type_created")
  @@map("conversations")
}

model Message {
  id             String       @id @db.VarChar(36)
  conversationId String       @map("conversation_id") @db.VarChar(36)
  role           String       @db.VarChar(16)
  content        String
  model          String?      @db.VarChar(64)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversationId], map: "ix_messages_conversation_id")
  @@index([conversationId, createdAt], map: "ix_messages_conversation_created")
  @@map("messages")
}

model Memory {
  id             String        @id @db.VarChar(36)
  userId         String        @map("user_id") @db.VarChar(36)
  type           memory_type
  content        String
  importance     Float
  embeddingId    Int?          @map("embedding_id")
  metadata       Json?         @map("metadata")
  conversationId String?       @map("conversation_id") @db.VarChar(36)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user           User          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId], map: "ix_memories_user_id")
  @@map("memories")
}

model KnowledgeBase {
  id          String              @id @db.VarChar(36)
  name        String              @db.VarChar(255)
  description String?
  category    String?             @db.VarChar(100)
  enabled     Boolean             @default(true)
  createdAt   DateTime?           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime?           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  chunks               KnowledgeChunk[]
  documents            KnowledgeDocument[]
  invertedIndexEntries KnowledgeInvertedIndex[]

  @@map("knowledge_bases")
}

model KnowledgeDocument {
  id              String           @id @db.VarChar(36)
  knowledgeBaseId String           @map("knowledge_base_id") @db.VarChar(36)
  title           String           @db.VarChar(500)
  content         String
  chunkCount      Int              @default(0) @map("chunk_count")
  status          String           @default("pending") @db.VarChar(20)
  enabled         Boolean          @default(true)
  createdAt       DateTime?        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime?        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // V2.2: 文件上传元数据（nullable，手动创建的文档为 null）
  originalFilename  String?        @map("original_filename") @db.VarChar(500)
  originalFileType  String?        @map("original_file_type") @db.VarChar(100)
  originalFileSize  Int?           @map("original_file_size")
  originalFilePath  String?        @map("original_file_path") @db.VarChar(1000)

  // V2.2: 失败原因与重试
  errorMessage      String?        @map("error_message") @db.VarChar(2000)
  retryCount        Int            @default(0) @map("retry_count")

  // V2.2: 质量标签（good / low，由 Worker quality gate 判定）
  qualityLabel      String?        @map("quality_label") @db.VarChar(20)

  chunks          KnowledgeChunk[]
  knowledgeBase   KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([knowledgeBaseId], map: "ix_knowledge_documents_kb_id")
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id              String            @id @db.VarChar(36)
  documentId      String            @map("document_id") @db.VarChar(36)
  knowledgeBaseId String            @map("knowledge_base_id") @db.VarChar(36)
  chunkIndex      Int               @map("chunk_index")
  content         String
  tokenCount      Int               @default(0) @map("token_count")
  milvusId        BigInt?           @map("milvus_id")
  enabled         Boolean           @default(true)
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)

  // V2.2: 来源类型与质量标签（供未来 search bias 使用）
  sourceType      String?           @map("source_type") @db.VarChar(20)
  qualityLabel    String?           @map("quality_label") @db.VarChar(20)

  document             KnowledgeDocument         @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  knowledgeBase        KnowledgeBase             @relation(fields: [knowledgeBaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invertedIndexEntries KnowledgeInvertedIndex[]

  @@index([documentId], map: "ix_knowledge_chunks_doc_id")
  @@index([knowledgeBaseId], map: "ix_knowledge_chunks_kb_id")
  @@map("knowledge_chunks")
}

model KnowledgeInvertedIndex {
  id       String   @id @db.VarChar(36)
  term     String   @db.VarChar(255)
  chunkId  String   @map("chunk_id") @db.VarChar(36)
  kbId     String   @map("kb_id") @db.VarChar(36)
  termFreq Int      @default(1) @map("term_freq")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  chunk        KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)

  @@index([term], map: "ix_inverted_index_term")
  @@index([chunkId], map: "ix_inverted_index_chunk")
  @@index([kbId, term], map: "ix_inverted_index_kb_term")

  @@map("knowledge_inverted_index")
}

model AgentSession {
  id                String       @id @db.VarChar(36)
  conversationId    String       @map("conversation_id") @db.VarChar(36)
  task              String
  status            String       @default("running") @db.VarChar(20)
  scratchpad        Json         @default("[]")
  finalSummary      String?      @map("final_summary")
  compressedSummary String?      @map("compressed_summary")
  startedAt         DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?    @map("completed_at") @db.Timestamptz(6)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  approvals         AgentApproval[]

  @@index([conversationId], map: "ix_agent_sessions_conversation_id")
  @@map("agent_sessions")
}

model AgentApproval {
  id              String        @id @db.VarChar(36)
  sessionId       String        @map("session_id") @db.VarChar(36)
  conversationId  String        @map("conversation_id") @db.VarChar(36)
  stepNumber      Int           @map("step_number")
  toolName        String        @map("tool_name") @db.VarChar(128)
  toolArgs        Json          @map("tool_args")
  riskLevel       String        @map("risk_level") @db.VarChar(20)
  reason          String        @db.VarChar(500)
  status          String        @default("pending") @db.VarChar(20)
  approvedBy      String?       @map("approved_by") @db.VarChar(36)
  modifiedArgs    Json?         @map("modified_args")
  rejectionReason String?       @map("rejection_reason") @db.VarChar(500)
  timeoutMs       Int           @default(300000) @map("timeout_ms")
  requestedAt     DateTime      @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedAt       DateTime?     @map("decided_at") @db.Timestamptz(6)
  session         AgentSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([sessionId], map: "ix_agent_approvals_session_id")
  @@index([status], map: "ix_agent_approvals_status")
  @@map("agent_approvals")
}

model SatisfactionRating {
  id             String       @id @db.VarChar(36)
  conversationId String       @map("conversation_id") @db.VarChar(36)
  messageId      String?      @map("message_id") @db.VarChar(36)
  rating         String       @db.VarChar(20)
  comment        String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId], map: "ix_satisfaction_ratings_conversation_id")
  @@index([createdAt], map: "ix_satisfaction_ratings_created_at")
  @@index([rating], map: "ix_satisfaction_ratings_rating")
  @@map("satisfaction_ratings")
}

model VoiceSession {
  id               String       @id @db.VarChar(36)
  conversationId   String       @map("conversation_id") @db.VarChar(36)
  status           String       @default("active") @db.VarChar(20)
  audioDurationSec Int          @default(0) @map("audio_duration_sec")
  asrTokenCount    Int          @default(0) @map("asr_token_count")
  ttsCharCount     Int          @default(0) @map("tts_char_count")
  transcript       Json         @default("[]")
  voice            String?      @db.VarChar(32)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId], map: "ix_voice_sessions_conversation_id")
  @@map("voice_sessions")
}

model VideoSession {
  id                String       @id @db.VarChar(36)
  conversationId    String       @map("conversation_id") @db.VarChar(36)
  status            String       @default("active") @db.VarChar(20)
  videoDurationSec  Int          @default(0) @map("video_duration_sec")
  audioDurationSec  Int          @default(0) @map("audio_duration_sec")
  asrTokenCount     Int          @default(0) @map("asr_token_count")
  ttsCharCount      Int          @default(0) @map("tts_char_count")
  visionFramesCount Int          @default(0) @map("vision_frames_count")
  transcript        Json         @default("[]")
  agentConfig       Json?        @map("agent_config")
  endedAt           DateTime?    @map("ended_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId], map: "ix_video_sessions_conversation_id")
  @@map("video_sessions")
}

model Workflow {
  id          String   @id @db.VarChar(36)
  userId      String   @map("user_id") @db.VarChar(36)
  name        String   @db.VarChar(200)
  description String?
  definition  Json
  version     Int      @default(1)
  status      String   @default("draft") @db.VarChar(20)
  tags        String[] @default([])
  runCount    Int      @default(0) @map("run_count")
  lastRunAt   DateTime? @map("last_run_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs        WorkflowRun[]

  @@index([userId, status], map: "ix_workflows_user_status")
  @@index([userId], map: "ix_workflows_user_id")
  @@map("workflows")
}

model WorkflowRun {
  id            String    @id @db.VarChar(36)
  workflowId    String    @map("workflow_id") @db.VarChar(36)
  userId        String    @map("user_id") @db.VarChar(36)
  status        String    @default("running") @db.VarChar(20)
  input         Json      @default("{}")
  output        Json?
  checkpoint    Json?
  currentStepId String?   @map("current_step_id") @db.VarChar(100)
  progress      Json      @default("{}")
  error         String?
  durationMs    Int?      @map("duration_ms")
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  workflow      Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stepLogs      WorkflowStepLog[]

  @@index([workflowId], map: "ix_workflow_runs_workflow")
  @@index([userId, status], map: "ix_workflow_runs_user_status")
  @@index([startedAt], map: "ix_workflow_runs_started")
  @@map("workflow_runs")
}

model WorkflowStepLog {
  id          String    @id @db.VarChar(36)
  runId       String    @map("run_id") @db.VarChar(36)
  stepId      String    @map("step_id") @db.VarChar(100)
  stepType    String    @map("step_type") @db.VarChar(50)
  status      String    @default("pending") @db.VarChar(20)
  input       Json?
  output      Json?
  error       String?
  retryCount  Int       @default(0) @map("retry_count")
  durationMs  Int?      @map("duration_ms")
  tokensUsed  Int       @default(0) @map("tokens_used")
  events      Json      @default("[]")
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  run         WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId], map: "ix_workflow_step_logs_run")
  @@index([runId, stepId], map: "ix_workflow_step_logs_run_step")
  @@map("workflow_step_logs")
}

model AgentTeam {
  id          String   @id @db.VarChar(36)
  userId      String   @map("user_id") @db.VarChar(36)
  name        String   @db.VarChar(200)
  description String?
  definition  Json
  tags        Json     @default("[]")
  status      String   @default("draft") @db.VarChar(20)
  version     Int      @default(1)
  runCount    Int      @default(0) @map("run_count")
  lastRunAt   DateTime? @map("last_run_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs        AgentTeamRun[]

  @@index([userId])
  @@index([status])
  @@index([updatedAt])
  @@map("agent_teams")
}

model AgentTeamRun {
  id             String    @id @db.VarChar(36)
  teamId         String    @map("team_id") @db.VarChar(36)
  userId         String    @map("user_id") @db.VarChar(36)
  conversationId String?   @map("conversation_id") @db.VarChar(36)
  task           String    @db.Text
  status         String    @default("running") @db.VarChar(20)
  mode           String    @db.VarChar(20)
  messages       Json      @default("[]")
  blackboard     Json      @default("{}")
  checkpoint     Json?
  output         Json?
  error          String?   @db.Text
  roundsCount    Int       @default(0) @map("rounds_count")
  durationMs     Int?      @map("duration_ms")
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  team           AgentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([teamId])
  @@index([userId])
  @@index([status])
  @@index([startedAt])
  @@map("agent_team_runs")
}

model AppProject {
  id          String   @id @db.VarChar(36)
  userId      String   @map("user_id") @db.VarChar(36)
  name        String   @db.VarChar(255)
  description String?
  status      String   @default("draft") @db.VarChar(32) // draft, generating, previewing, deployed, archived
  type        String   @default("frontend") @db.VarChar(32) // frontend, fullstack
  framework   String   @default("react") @db.VarChar(32) // react, vue, html, nextjs
  previewUrl  String?  @map("preview_url") @db.VarChar(500)
  deployUrl   String?  @map("deploy_url") @db.VarChar(500)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  files       ProjectFile[]
  runs        AppGenRun[]

  @@index([userId, updatedAt])
  @@map("app_projects")
}

model ProjectFile {
  id        String   @id @db.VarChar(36)
  projectId String   @map("project_id") @db.VarChar(36)
  path      String   @db.VarChar(500)
  content   String   @db.Text
  language  String   @db.VarChar(32) // tsx, ts, css, html, json, py
  size      Int      @default(0)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  project   AppProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
  @@map("project_files")
}

model AppGenRun {
  id             String   @id @db.VarChar(36)
  projectId      String   @map("project_id") @db.VarChar(36)
  prompt         String   @db.Text
  status         String   @default("running") @db.VarChar(32) // running, completed, failed
  result         Json?    // { files_created: string[], tokens_used: number, errors: string[] }
  agentSessionId String?  @map("agent_session_id") @db.VarChar(36)
  startedAt      DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  project        AppProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("app_gen_runs")
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

enum memory_type {
  episodic
  semantic
  preference
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public")]
}

model User {
  id            String         @id @db.VarChar(36)
  email         String         @unique(map: "ix_users_email") @db.VarChar(255)
  passwordHash  String?        @map("password_hash") @db.VarChar(255)
  avatarUrl     String?        @map("avatar_url") @db.VarChar(500)
  role          String         @default("user") @db.VarChar(20)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  conversations Conversation[]
  refreshTokens RefreshToken[]
  apiKeys       ApiKey[]
  workflows     Workflow[]
  workflowRuns  WorkflowRun[]
  agentTeams    AgentTeam[]
  agentTeamRuns AgentTeamRun[]
  appProjects   AppProject[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ix_refresh_tokens_user_id")
  @@index([tokenHash], map: "ix_refresh_tokens_token_hash")
  @@map("refresh_tokens")
}

model ApiKey {
  id        String    @id @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  name      String    @db.VarChar(100)
  keyHash   String    @map("key_hash") @db.VarChar(255)
  lastUsed  DateTime? @map("last_used") @db.Timestamptz(6)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ix_api_keys_user_id")
  @@index([keyHash], map: "ix_api_keys_key_hash")
  @@map("api_keys")
}

model Conversation {
  id        String    @id @db.VarChar(36)
  title     String    @db.VarChar(255)
  userId    String    @map("user_id") @db.VarChar(36)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  type           String         @default("chat") @db.VarChar(32)
  sessionId      String?        @map("session_id") @db.VarChar(64)
  intent         String?        @db.VarChar(100)
  rating         String?        @db.VarChar(20)
  status         String?        @default("active") @db.VarChar(20)
  customerMeta   Json?          @map("customer_meta")
  user           User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages       Message[]
  agentSessions  AgentSession[]
  ratings        SatisfactionRating[]
  approvals      AgentApproval[]
  voiceSessions  VoiceSession[]
  videoSessions  VideoSession[]

  @@index([sessionId], map: "ix_conversations_session_id")
  @@index([userId], map: "ix_conversations_user_id")
  @@index([userId, updatedAt], map: "ix_conversations_user_updated")
  @@index([type, createdAt], map: "ix_conversations_type_created")
  @@map("conversations")
}

model Message {
  id             String       @id @db.VarChar(36)
  conversationId String       @map("conversation_id") @db.VarChar(36)
  role           String       @db.VarChar(16)
  content        String
  model          String?      @db.VarChar(64)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversationId], map: "ix_messages_conversation_id")
  @@index([conversationId, createdAt], map: "ix_messages_conversation_created")
  @@map("messages")
}

model KnowledgeBase {
  id          String              @id @db.VarChar(36)
  name        String              @db.VarChar(255)
  description String?
  category    String?             @db.VarChar(100)
  enabled     Boolean             @default(true)
  createdAt   DateTime?           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime?           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // V3.1: Token-aware 分片参数（nullable，null 时使用环境默认值）
  chunkSizeTokens    Int?    @map("chunk_size_tokens")
  chunkOverlapTokens Int?    @map("chunk_overlap_tokens")

  // V3.4: 切分模式与自定义分隔符
  separatorMode   String? @default("auto") @map("separator_mode") @db.VarChar(20)  // "auto" | "custom"
  customSeparator String? @map("custom_separator") @db.VarChar(100)               // 如 "\n## "、"\n\n"

  // V3.4: 层次分块（parent-child chunking）
  chunkStructure    String? @default("paragraph") @map("chunk_structure") @db.VarChar(20)  // "paragraph" | "hierarchical"
  childChunkSize    Int?    @map("child_chunk_size_tokens")                                // 子分块 token 数
  childChunkOverlap Int?    @map("child_chunk_overlap_tokens")                             // 子分块 overlap

  // V3.5: 文本预处理规则（参考 Dify PRE_PROCESSING_RULES）
  removeExtraSpaces Boolean  @default(true)  @map("remove_extra_spaces")
  removeUrlsEmails  Boolean  @default(false) @map("remove_urls_emails")

  chunks    KnowledgeChunk[]
  documents KnowledgeDocument[]

  @@map("knowledge_bases")
}

model KnowledgeDocument {
  id              String           @id @db.VarChar(36)
  knowledgeBaseId String           @map("knowledge_base_id") @db.VarChar(36)
  title           String           @db.VarChar(500)
  content         String
  chunkCount      Int              @default(0) @map("chunk_count")
  status          String           @default("pending") @db.VarChar(50)
  enabled         Boolean          @default(true)
  createdAt       DateTime?        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime?        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // V2.2: 文件上传元数据（nullable，手动创建的文档为 null）
  originalFilename  String?        @map("original_filename") @db.VarChar(500)
  originalFileType  String?        @map("original_file_type") @db.VarChar(100)
  originalFileSize  Int?           @map("original_file_size")
  originalFilePath  String?        @map("original_file_path") @db.VarChar(1000)

  // V2.2: 失败原因与重试
  errorMessage      String?        @map("error_message") @db.VarChar(2000)
  retryCount        Int            @default(0) @map("retry_count")

  // V2.2: 质量标签（good / low，由 Worker quality gate 判定）
  qualityLabel      String?        @map("quality_label") @db.VarChar(20)

  // V3.1: 处理进度详情（JSON：{phase, progress, total, message, startedAt}）
  processingDetail  String?        @map("processing_detail")

  // V3.2: 阶段时间戳 — 参考 Dify Document 模型的 per-stage timestamp 设计
  processingStartedAt      DateTime? @map("processing_started_at") @db.Timestamptz(6)
  downloadingCompletedAt   DateTime? @map("downloading_completed_at") @db.Timestamptz(6)
  parsingCompletedAt       DateTime? @map("parsing_completed_at") @db.Timestamptz(6)
  normalizingCompletedAt   DateTime? @map("normalizing_completed_at") @db.Timestamptz(6)
  chunkingCompletedAt      DateTime? @map("chunking_completed_at") @db.Timestamptz(6)
  embeddingCompletedAt     DateTime? @map("embedding_completed_at") @db.Timestamptz(6)

  chunks          KnowledgeChunk[]
  knowledgeBase   KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([knowledgeBaseId], map: "ix_knowledge_documents_kb_id")
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id              String            @id @db.VarChar(36)
  documentId      String            @map("document_id") @db.VarChar(36)
  knowledgeBaseId String            @map("knowledge_base_id") @db.VarChar(36)
  chunkIndex      Int               @map("chunk_index")
  content         String
  tokenCount      Int               @default(0) @map("token_count")
  embedding       Unsupported("vector(1024)")?  // PGVector 语义向量（bge-m3 / text-embedding-v3 = 1024 维）
  enabled         Boolean           @default(true)
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)

  // V2.2: 来源类型与质量标签（供未来 search bias 使用）
  sourceType      String?           @map("source_type") @db.VarChar(20)
  qualityLabel    String?           @map("quality_label") @db.VarChar(20)

  // V3.4: 层次分块 — 子分块指向父分块（nullable，普通分块为 null）
  parentChunkId String?         @map("parent_chunk_id") @db.VarChar(36)
  parentChunk   KnowledgeChunk? @relation("ChildChunks", fields: [parentChunkId], references: [id], onDelete: SetNull)
  childChunks   KnowledgeChunk[] @relation("ChildChunks")

  document      KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  knowledgeBase KnowledgeBase     @relation(fields: [knowledgeBaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([documentId], map: "ix_knowledge_chunks_doc_id")
  @@index([knowledgeBaseId], map: "ix_knowledge_chunks_kb_id")
  @@map("knowledge_chunks")
}

// V3.5: 检索审计日志（hit-testing / 搜索查询记录）
model KnowledgeQueryLog {
  id        String   @id @db.VarChar(36)
  kbId      String   @map("kb_id") @db.VarChar(36)
  query     String   @db.VarChar(1000)
  method    String   @default("hybrid") @db.VarChar(20)  // "hybrid" | "semantic" | "keyword"
  results   Int      @default(0)
  source    String   @default("hit_testing") @db.VarChar(20)  // "hit_testing" | "search" | "agent"
  elapsedMs Int      @default(0) @map("elapsed_ms")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([kbId], map: "ix_query_log_kb")
  @@index([createdAt], map: "ix_query_log_created")
  @@map("knowledge_query_logs")
}

model AgentSession {
  id                String       @id @db.VarChar(36)
  conversationId    String       @map("conversation_id") @db.VarChar(36)
  task              String
  status            String       @default("running") @db.VarChar(20)
  scratchpad        Json         @default("[]")
  finalSummary      String?      @map("final_summary")
  compressedSummary String?      @map("compressed_summary")
  runtimeState      Json?        @map("runtime_state")
  startedAt         DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?    @map("completed_at") @db.Timestamptz(6)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  approvals         AgentApproval[]

  @@index([conversationId], map: "ix_agent_sessions_conversation_id")
  @@map("agent_sessions")
}

model AgentApproval {
  id              String        @id @db.VarChar(36)
  sessionId       String        @map("session_id") @db.VarChar(36)
  conversationId  String        @map("conversation_id") @db.VarChar(36)
  stepNumber      Int           @map("step_number")
  toolName        String        @map("tool_name") @db.VarChar(128)
  toolArgs        Json          @map("tool_args")
  riskLevel       String        @map("risk_level") @db.VarChar(20)
  reason          String        @db.VarChar(500)
  status          String        @default("pending") @db.VarChar(20)
  approvedBy      String?       @map("approved_by") @db.VarChar(36)
  modifiedArgs    Json?         @map("modified_args")
  rejectionReason String?       @map("rejection_reason") @db.VarChar(500)
  timeoutMs       Int           @default(300000) @map("timeout_ms")
  requestedAt     DateTime      @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedAt       DateTime?     @map("decided_at") @db.Timestamptz(6)
  session         AgentSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([sessionId], map: "ix_agent_approvals_session_id")
  @@index([status], map: "ix_agent_approvals_status")
  @@map("agent_approvals")
}

model SatisfactionRating {
  id             String       @id @db.VarChar(36)
  conversationId String       @map("conversation_id") @db.VarChar(36)
  messageId      String?      @map("message_id") @db.VarChar(36)
  rating         String       @db.VarChar(20)
  comment        String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId], map: "ix_satisfaction_ratings_conversation_id")
  @@index([createdAt], map: "ix_satisfaction_ratings_created_at")
  @@index([rating], map: "ix_satisfaction_ratings_rating")
  @@map("satisfaction_ratings")
}

model VoiceSession {
  id               String       @id @db.VarChar(36)
  conversationId   String       @map("conversation_id") @db.VarChar(36)
  status           String       @default("active") @db.VarChar(20)
  audioDurationSec Int          @default(0) @map("audio_duration_sec")
  asrTokenCount    Int          @default(0) @map("asr_token_count")
  ttsCharCount     Int          @default(0) @map("tts_char_count")
  transcript       Json         @default("[]")
  voice            String?      @db.VarChar(32)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId], map: "ix_voice_sessions_conversation_id")
  @@map("voice_sessions")
}

model VideoSession {
  id                String       @id @db.VarChar(36)
  conversationId    String       @map("conversation_id") @db.VarChar(36)
  status            String       @default("active") @db.VarChar(20)
  videoDurationSec  Int          @default(0) @map("video_duration_sec")
  audioDurationSec  Int          @default(0) @map("audio_duration_sec")
  asrTokenCount     Int          @default(0) @map("asr_token_count")
  ttsCharCount      Int          @default(0) @map("tts_char_count")
  visionFramesCount Int          @default(0) @map("vision_frames_count")
  transcript        Json         @default("[]")
  agentConfig       Json?        @map("agent_config")
  endedAt           DateTime?    @map("ended_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId], map: "ix_video_sessions_conversation_id")
  @@map("video_sessions")
}

model Workflow {
  id          String   @id @db.VarChar(36)
  userId      String   @map("user_id") @db.VarChar(36)
  name        String   @db.VarChar(200)
  description String?
  definition  Json
  version     Int      @default(1)
  status      String   @default("draft") @db.VarChar(20)
  tags        String[] @default([])
  runCount    Int      @default(0) @map("run_count")
  lastRunAt   DateTime? @map("last_run_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs        WorkflowRun[]

  @@index([userId, status], map: "ix_workflows_user_status")
  @@index([userId], map: "ix_workflows_user_id")
  @@map("workflows")
}

model WorkflowRun {
  id            String    @id @db.VarChar(36)
  workflowId    String    @map("workflow_id") @db.VarChar(36)
  userId        String    @map("user_id") @db.VarChar(36)
  status        String    @default("running") @db.VarChar(20)
  input         Json      @default("{}")
  output        Json?
  checkpoint    Json?
  currentStepId String?   @map("current_step_id") @db.VarChar(100)
  progress      Json      @default("{}")
  error         String?
  durationMs    Int?      @map("duration_ms")
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  workflow      Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stepLogs      WorkflowStepLog[]

  @@index([workflowId], map: "ix_workflow_runs_workflow")
  @@index([userId, status], map: "ix_workflow_runs_user_status")
  @@index([startedAt], map: "ix_workflow_runs_started")
  @@map("workflow_runs")
}

model WorkflowStepLog {
  id          String    @id @db.VarChar(36)
  runId       String    @map("run_id") @db.VarChar(36)
  stepId      String    @map("step_id") @db.VarChar(100)
  stepType    String    @map("step_type") @db.VarChar(50)
  status      String    @default("pending") @db.VarChar(20)
  input       Json?
  output      Json?
  error       String?
  retryCount  Int       @default(0) @map("retry_count")
  durationMs  Int?      @map("duration_ms")
  tokensUsed  Int       @default(0) @map("tokens_used")
  events      Json      @default("[]")
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  run         WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId], map: "ix_workflow_step_logs_run")
  @@index([runId, stepId], map: "ix_workflow_step_logs_run_step")
  @@map("workflow_step_logs")
}

model AgentTeam {
  id          String   @id @db.VarChar(36)
  userId      String   @map("user_id") @db.VarChar(36)
  name        String   @db.VarChar(200)
  description String?
  definition  Json
  tags        Json     @default("[]")
  status      String   @default("draft") @db.VarChar(20)
  version     Int      @default(1)
  runCount    Int      @default(0) @map("run_count")
  lastRunAt   DateTime? @map("last_run_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs        AgentTeamRun[]

  @@index([userId])
  @@index([status])
  @@index([updatedAt])
  @@map("agent_teams")
}

model AgentTeamRun {
  id             String    @id @db.VarChar(36)
  teamId         String    @map("team_id") @db.VarChar(36)
  userId         String    @map("user_id") @db.VarChar(36)
  conversationId String?   @map("conversation_id") @db.VarChar(36)
  task           String    @db.Text
  status         String    @default("running") @db.VarChar(20)
  mode           String    @db.VarChar(20)
  messages       Json      @default("[]")
  blackboard     Json      @default("{}")
  checkpoint     Json?
  output         Json?
  error          String?   @db.Text
  roundsCount    Int       @default(0) @map("rounds_count")
  durationMs     Int?      @map("duration_ms")
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  team           AgentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([teamId])
  @@index([userId])
  @@index([status])
  @@index([startedAt])
  @@map("agent_team_runs")
}

model AppProject {
  id          String   @id @db.VarChar(36)
  userId      String   @map("user_id") @db.VarChar(36)
  name        String   @db.VarChar(255)
  description String?
  status      String   @default("draft") @db.VarChar(32) // draft, generating, previewing, deployed, archived
  type        String   @default("frontend") @db.VarChar(32) // frontend, fullstack
  framework   String   @default("react") @db.VarChar(32) // react, vue, html, nextjs
  previewUrl  String?  @map("preview_url") @db.VarChar(500)
  deployUrl   String?  @map("deploy_url") @db.VarChar(500)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  files       ProjectFile[]
  runs        AppGenRun[]

  @@index([userId, updatedAt])
  @@map("app_projects")
}

model ProjectFile {
  id        String   @id @db.VarChar(36)
  projectId String   @map("project_id") @db.VarChar(36)
  path      String   @db.VarChar(500)
  content   String   @db.Text
  language  String   @db.VarChar(32) // tsx, ts, css, html, json, py
  size      Int      @default(0)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  project   AppProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
  @@map("project_files")
}

model AppGenRun {
  id             String   @id @db.VarChar(36)
  projectId      String   @map("project_id") @db.VarChar(36)
  prompt         String   @db.Text
  status         String   @default("running") @db.VarChar(32) // running, completed, failed
  result         Json?    // { files_created: string[], tokens_used: number, errors: string[] }
  agentSessionId String?  @map("agent_session_id") @db.VarChar(36)
  startedAt      DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  project        AppProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("app_gen_runs")
}

model KnowledgeGraphEntity {
  id        String   @id @db.VarChar(36)
  name      String   @db.VarChar(500)
  type      String   @db.VarChar(100)
  kbId      String   @map("kb_id") @db.VarChar(36)
  docIds    String[] @map("doc_ids")
  aliases   String[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([name, type], map: "ix_knowledge_graph_entities_name_type")
  @@index([kbId], map: "ix_knowledge_graph_entities_kb_id")
  @@index([type], map: "ix_knowledge_graph_entities_type")
  @@map("knowledge_graph_entities")
}

model KnowledgeGraphRelation {
  id            String   @id @db.VarChar(36)
  fromEntityId  String   @map("from_entity_id") @db.VarChar(36)
  toEntityId    String   @map("to_entity_id") @db.VarChar(36)
  relType       String   @map("rel_type") @db.VarChar(100)
  confidence    Float
  sourceChunkId String   @map("source_chunk_id") @db.VarChar(36)
  docId         String   @map("doc_id") @db.VarChar(36)
  evidence      String?  @db.VarChar(2000)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([fromEntityId], map: "ix_kg_relations_from")
  @@index([toEntityId], map: "ix_kg_relations_to")
  @@index([sourceChunkId], map: "ix_kg_relations_chunk")
  @@index([docId], map: "ix_kg_relations_doc")
  @@map("knowledge_graph_relations")
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

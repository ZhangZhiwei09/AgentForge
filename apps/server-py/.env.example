# AgentForge 环境变量 —— 复制为 .env 后填入实际值
# 所有字段均有默认值，本地开发无需 .env 也能启动

# 数据库（默认 localhost:5434）
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/agentforge

# Redis（默认 localhost:6379）
REDIS_URL=redis://localhost:6379

# OpenAI API Key（调 LLM 需要）
OPENAI_API_KEY=sk-your-key-here

# Server
PORT=8000
DEBUG=false

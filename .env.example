# ── AgentForge 环境变量模板 ──
# 复制此文件为 .env 并填入实际值：cp .env.example .env

# 数据库 (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/agentforge

# OpenAI API（LLM 对话 + Embedding + TTS + STT）
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek API（备选 LLM，性价比更高）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 默认模型 ID
DEFAULT_MODEL=gpt-4o-mini

# Milvus 向量数据库
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Embedding 模型名称
EMBEDDING_MODEL=text-embedding-v2

# 服务端口
PORT=8000

# Redis（可选，用于限流等）
REDIS_URL=redis://localhost:6379

# 调试模式
DEBUG=false

# ── 以下为可选配置 ──

# 代码沙箱 (Docker)
# SANDBOX_IMAGE=agentforge-sandbox:latest
# SANDBOX_TIMEOUT_SEC=60
# SANDBOX_MEMORY_MB=256

# 语音 Agent (V5) — 复用 OPENAI_API_KEY
# VOICE_ENABLED=true
# ASR_MODEL=whisper-1
# TTS_MODEL=tts-1
# TTS_VOICE=alloy

# 视频对话 (V11) — 复用 OPENAI_API_KEY，需多模态模型
# VIDEO_ENABLED=true
# VIDEO_MODEL=gpt-4o

# OpenTelemetry（可选，链路追踪）
# OTEL_ENABLED=false

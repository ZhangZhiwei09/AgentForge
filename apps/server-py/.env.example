# AgentForge 环境变量 —— 复制为 .env 后填入实际值
# 所有字段均有默认值，本地开发无需 .env 也能启动

# 数据库（默认 localhost:5434）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/agentforge_py

# Redis（默认 localhost:6379）
REDIS_URL=redis://localhost:6379

# JWT（与 TS 端共享同一个密钥，用于验证 TS 签发的 Token）
JWT_SECRET=agentforge-dev-secret-change-in-production

# OpenAI（调 LLM 需要）
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o-mini

# Server
PORT=8000
DEBUG=false

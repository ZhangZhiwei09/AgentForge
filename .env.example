# Local Python configuration: apps/server-py/.env. Never commit actual secrets.
# Development compatibility only; production Compose fixes these public switches off.
APP_ENV=development
AUTH_SIGNUP_ENABLED=true
ANONYMOUS_CHAT_ENABLED=true
PUBLIC_FAQ_ENABLED=true
# Mock evidence is available only with explicit opt-in outside production.
MONITORING_MODE=disabled
AGENT_MAX_TOKENS=50000
AGENT_MAX_COST_CENTS=200
AGENT_MAX_ITERATIONS=20
AGENT_ALLOWED_TOOLS=["search_knowledge_base","get_current_time","calculator"]
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5434/agentforge
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=agentforge-dev-secret-change-in-production
PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:5200

# Any OpenAI-compatible chat provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o-mini
# Local launcher also maps legacy DEEPSEEK_API_KEY/DEEPSEEK_BASE_URL for deepseek models.

# Retained database vectors have 1024 dimensions. OpenAI text-embedding-3 models
# request 1024 explicitly. For Ollama, set bge-m3 and http://localhost:11434/v1.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
PGVECTOR_ENABLED=true
ELASTICSEARCH_URL=
RERANKER_BASE_URL=
RERANKER_MODEL=

# For a new local installation. Existing absolute upload paths remain readable.
KNOWLEDGE_STORAGE_ROOT=./data/knowledge-files
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=agentforge-docs
MINIO_USE_SSL=false
VIDEO_MODEL=gpt-4o-mini

# Enable with pnpm server:worker and persistent Redis.
INGESTION_ASYNC_ENABLED=false
INGESTION_JOB_TIMEOUT_SECONDS=300
INGESTION_LEASE_SECONDS=360
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=60
RATE_LIMIT_REDIS_ENABLED=false
FILE_WORKSPACE=
TAVILY_API_KEY=

LANGGRAPH_CHECKPOINT_ENABLED=false
LANGGRAPH_DIAGNOSIS_CHECKPOINT_ENABLED=true
LANGGRAPH_DIAGNOSIS_HITL_ENABLED=false
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

REDIS_MEMORY_ENABLED=true
REDIS_MEMORY_WINDOW_SIZE=20
REDIS_MEMORY_MESSAGE_TTL_SECONDS=604800
REDIS_MEMORY_SUMMARY_TTL_SECONDS=2592000

# Production Compose also requires POSTGRES_PASSWORD, REDIS_PASSWORD and a
# DATABASE_URL/REDIS_URL using internal db:5432 and redis:6379 hosts.
# URL-encode special characters in passwords when embedding them in URLs.

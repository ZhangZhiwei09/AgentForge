# ── AgentForge 环境变量模板 ──
# 复制此文件为 apps/server/.env 并填入实际值：cp .env.example apps/server/.env
#
# 警告：apps/server/.env 包含密钥，切勿提交到 Git！
#       生产环境应通过环境变量或 Secrets Manager 注入。

# ════════════════════════════════════════════════════════════════
# 必需配置
# ════════════════════════════════════════════════════════════════

# 数据库 (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/agentforge

# OpenAI API（LLM 对话 + Embedding + TTS + STT）
# 支持 DashScope 兼容：OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek API（备选 LLM，性价比更高）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 默认模型 ID（会从所有 provider 的模型列表中匹配）
DEFAULT_MODEL=gpt-4o-mini

# ── Embedding 配置 ──────────────────────────────────────
# 方式一：Ollama 本地模型（推荐，免费，无需 API Key）
# docker compose up -d ollama && ollama pull bge-m3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
# 方式二：OpenAI 兼容 API（DashScope / OpenAI / 自定义代理）
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=sk-your-embedding-api-key

# Milvus 向量数据库
MILVUS_HOST=localhost
MILVUS_PORT=19530

# 服务端口
PORT=8000

# Redis（用于限流和队列，BullMQ 依赖）
REDIS_URL=redis://localhost:6379

# CORS 允许的前端地址（生产环境必填，逗号分隔）
# 例如：CORS_ORIGINS=https://cs.example.com,https://admin.example.com
# 留空时开发环境默认允许 localhost 常用端口，生产环境拒绝所有跨域请求
CORS_ORIGINS=

# 调试模式 — 生产环境必须设为 false
DEBUG=false

# ════════════════════════════════════════════════════════════════
# 可选配置
# ════════════════════════════════════════════════════════════════

# 高德地图 API Key（工具调用使用）
# AMAP_MAPS_API_KEY=your-amap-api-key

# 代码沙箱 (Docker)
# SANDBOX_IMAGE=agentforge-sandbox:latest
# SANDBOX_TIMEOUT_SEC=60
# SANDBOX_MEMORY_MB=256
# SANDBOX_CPU_SHARES=512

# 语音 Agent (V5) — 复用 OPENAI_API_KEY
VOICE_ENABLED=true
# ASR_MODEL=whisper-1
# TTS_MODEL=tts-1
# TTS_VOICE=alloy
# TTS_SPEED=1.0

# 视频对话 Agent (V11) — 复用 OPENAI_API_KEY，需多模态模型
VIDEO_ENABLED=true
# VIDEO_MODEL=gpt-4o
# VIDEO_VISION_FPS=1

# ════════════════════════════════════════════════════════════════
# 可观测性
# ════════════════════════════════════════════════════════════════

# OpenTelemetry 链路追踪
# OTEL_ENABLED=false

# LangSmith 追踪（SaaS 替代品）
# LANGCHAIN_API_KEY=your-langsmith-api-key
# LANGCHAIN_PROJECT=agentforge-prod
# LANGCHAIN_TRACING_V2=false

# Langfuse LLM Observability（自托管，推荐生产使用）
LANGFUSE_ENABLED=true
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-placeholder
LANGFUSE_SECRET_KEY=sk-lf-placeholder

# ════════════════════════════════════════════════════════════════
# V3.0 知识检索升级 — RAG + 知识图谱 + 多模态解析 + 分层记忆
# ════════════════════════════════════════════════════════════════

# ── PGVector（向量检索）────────────────────────────────────
PGVECTOR_ENABLED=true

# ── Elasticsearch（关键词检索）─────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ── Reranker（精排模型）────────────────────────────────────
# 留空则使用 RRF 融合分数直接排序（无重排）
RERANKER_BASE_URL=
RERANKER_MODEL=

# ── Neo4j（知识图谱）───────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agentforge123

# ── MinIO（文档资产对象存储）───────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agentforge-docs
MINIO_USE_SSL=false

# ── Mem0（长期记忆）────────────────────────────────────────
# 留空则降级到 MemoryEngine (PG + Milvus)
MEM0_API_KEY=
MEM0_BASE_URL=

# ── 分层记忆可配置参数 ──────────────────────────────────
# 短期记忆滑动窗口大小（保留最近 N 条消息，默认 20）
# MEMORY_WINDOW_SIZE=20
# 触发摘要生成的阈值（消息数超过此值 → LLM 压缩旧消息，默认 30）
# MEMORY_SUMMARY_TRIGGER=30
# 短期记忆 TTL 天数（过期自动清理，默认 7）
# MEMORY_TTL_DAYS=7
# 长期记忆检索默认 topK（默认 5）
# MEMORY_LONGTERM_TOPK=5
